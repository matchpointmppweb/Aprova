// Schema Prisma — Raiz
// Fonte de verdade do modelo de dados (AD-5 da arquitetura).
// Escopo desta story (1.1): entidades mínimas para login, recuperação de
// senha e casca do painel (AD-13) — Conta, Usuario, PerfilAcesso/PermissaoModulo
// — mais as tabelas exigidas pelo Better Auth (Session, Account, Verification).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PlanoContratado {
  Essencial
  Corporativo
}

enum StatusConta {
  Ativa
  PagamentoPendente
}

enum StatusUsuario {
  Ativo
  ConvitePendente
  Inativo
}

/// Status de TipoAtivo (Story 2.1) — "arquivar" é só mudar este campo para
/// Arquivado pelo próprio formulário de edição; não há exclusão física
/// nesta tela (Boundaries da story).
enum StatusTipoAtivo {
  Ativo
  Arquivado
}

/// Status de Ativo (Story 2.2). "Excluir" nunca é DELETE físico (AD-10): é
/// atualizarAtivo(...,{status:"Inativo"}) pela mesma função de repositório
/// usada pela edição comum — Boundaries da story.
enum StatusAtivo {
  Ativo
  Inativo
  Bloqueado
  Vendido
}

/// Status de ItemRevisional (Story 3.1) — mesmo padrão de StatusTipoAtivo:
/// "excluir" nunca é DELETE físico (AD-10), é atualizarItemRevisional(...,
/// {status:"Arquivado"}) pela mesma função de repositório usada pela edição
/// comum.
enum StatusItemRevisional {
  Ativo
  Arquivado
}

/// Status de PlanoRevisional (Story 3.2) — mesmo padrão de
/// StatusItemRevisional: "excluir" nunca é DELETE físico (AD-10), é
/// atualizarPlano(...,{status:"Arquivado"}) pela mesma função de repositório
/// usada pela edição comum. Este é o único status persistido do plano — "No
/// prazo"/"Vence em breve" NUNCA são persistidos, sempre computados on-read
/// por resolverAtivosDoPlano (AD-8, Boundaries da story).
enum StatusPlanoRevisional {
  Ativo
  Arquivado
}

/// Status de Emissao (Story 4.1). Nasce sempre em Rascunho — o avanço
/// Rascunho->EmAnalise->Emitido/Reprovado é a Story 4.2, que ainda não
/// existe (Boundaries: nesta story não há nenhuma lógica de avanço, nem
/// campo de Status editável no modal). Diferente de
/// StatusAtivo/StatusTipoAtivo/StatusItemRevisional/StatusPlanoRevisional,
/// não tem um valor de arquivamento — AD-10 não vincula Emissao (CAP-5) à
/// sua regra de soft-delete, então "excluir" fica fora de escopo (Design
/// Notes, deferred-work.md).
enum StatusEmissao {
  Rascunho
  EmAnalise
  Emitido
  Reprovado
}

/// Status de Local (Story 5.1) — mesmo padrão de StatusTipoAtivo: "excluir"
/// nunca é DELETE físico (AD-10), é atualizarLocal(...,{status:"Inativo"})
/// pela mesma função de repositório usada pela edição comum.
enum StatusLocal {
  Ativo
  Inativo
}

/// Status de Cargo (Story 5.3) — mesmo padrão de StatusLocal: "excluir"
/// nunca é DELETE físico (AD-10), é atualizarCargo(...,{status:"Inativo"})
/// pela mesma função de repositório usada pela edição comum.
enum StatusCargo {
  Ativo
  Inativo
}

/// Status de Funcao (Story 5.3) — mesmo padrão de StatusCargo/StatusLocal:
/// "excluir" nunca é DELETE físico (AD-10), é
/// atualizarFuncao(...,{status:"Inativo"}) pela mesma função de repositório
/// usada pela edição comum.
enum StatusFuncao {
  Ativo
  Inativo
}

/// Chave de módulo usada por can() e pelas linhas de permissão do Perfil de
/// acesso (Consistency Conventions da arquitetura). "contas" existe como
/// chave mas nunca é selecionável na UI de Perfil de acesso (AD-13).
enum Modulo {
  ativos
  tipos
  itens
  planos
  emissao
  locais
  empresas
  cargos
  funcoes
  pessoas
  usuarios
  contas
  perfil
  aparencia
}

// ---------------------------------------------------------------------------
// Conta (tenant) — raiz do isolamento multi-tenant (AD-1)
// ---------------------------------------------------------------------------

model Conta {
  id              String          @id @default(cuid())
  nome            String
  /// Único em toda a plataforma (Boundaries da Story 1.4 — gestão de contas
  /// pelo operador de plataforma) — constraint nova; antes desta story nunca
  /// era possível criar uma 2ª Conta pela UI para alcançar a colisão.
  cnpj            String          @unique
  planoContratado PlanoContratado @default(Essencial)
  status          StatusConta     @default(Ativa)
  /// Configuração de Aparência (CAP-11 / AD-11) — por conta, edição restrita
  /// a Administrador via can('editar','aparencia').
  paletaDeCores   String          @default("verde-floresta")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  usuarios          Usuario[]
  perfisAcesso      PerfilAcesso[]
  tiposDeAtivo      TipoAtivo[]
  ativos            Ativo[]
  itensRevisionais  ItemRevisional[]
  planosRevisionais PlanoRevisional[]
  emissoes          Emissao[]
  locais            Local[]
  empresas          Empresa[]
  cargos            Cargo[]
  funcoes           Funcao[]
  pessoas           Pessoa[]

  @@map("contas")
}

// ---------------------------------------------------------------------------
// Usuario — também é o modelo "user" do Better Auth (credentials + sessão em
// banco). O campo `name` exigido pelo Better Auth é mapeado para `nome`
// (server/auth/index.ts: user.fields.name = "nome"); contaId,
// perfilAcessoId, isPlataformaOperador, status e ultimoAcesso são
// registrados como additionalFields para sobreviver ao parse de saída do
// Better Auth e ficarem disponíveis via auth.api.getSession() (AD-1: sessão
// carrega contaId).
// ---------------------------------------------------------------------------

model Usuario {
  id            String  @id @default(cuid())
  nome          String
  email         String
  emailVerified Boolean @default(false)
  image         String?

  status               StatusUsuario @default(Ativo)
  ultimoAcesso         DateTime?
  /// Independente do PerfilAcesso (AD-13) — gate exclusivo da área de Contas
  /// (CAP-8, Story 1.4). Só os operadores da plataforma Raiz têm `true`.
  isPlataformaOperador Boolean       @default(false)

  contaId String
  conta   Conta  @relation(fields: [contaId], references: [id], onDelete: Cascade)

  perfilAcessoId String
  perfilAcesso   PerfilAcesso @relation(fields: [perfilAcessoId], references: [id])

  sessions Session[]
  accounts Account[]

  planosComoResponsavel   PlanoRevisional[]
  emissoesComoResponsavel Emissao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contaId, email])
  @@map("usuarios")
}

// ---------------------------------------------------------------------------
// Tabelas do Better Auth (sessão em banco, credentials, reset de senha)
// ---------------------------------------------------------------------------

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  usuario   Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessoes")
}

model Account {
  id      String  @id @default(cuid())
  userId  String
  usuario Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "credential" para login por e-mail/senha; providers sociais ficam para
  /// uma story futura.
  providerId String
  accountId  String
  /// Hash da senha (só preenchido para providerId = "credential").
  password   String?

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@map("contas_de_login")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verificacoes")
}

// ---------------------------------------------------------------------------
// PerfilAcesso / PermissaoModulo (CAP-9) — matriz de permissões por módulo
// (perfis-de-acesso.md). Edição de perfis é escopo da Story 1.3; aqui só o
// necessário para o seed dos 4 perfis padrão e o vínculo do Usuario.
// ---------------------------------------------------------------------------

model PerfilAcesso {
  id        String  @id @default(cuid())
  contaId   String
  conta     Conta   @relation(fields: [contaId], references: [id], onDelete: Cascade)
  nome      String
  descricao String?

  permissoes PermissaoModulo[]
  usuarios   Usuario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contaId, nome])
  @@map("perfis_de_acesso")
}

model PermissaoModulo {
  id             String       @id @default(cuid())
  perfilAcessoId String
  perfilAcesso   PerfilAcesso @relation(fields: [perfilAcessoId], references: [id], onDelete: Cascade)
  modulo         Modulo
  criar          Boolean      @default(false)
  editar         Boolean      @default(false)
  excluir        Boolean      @default(false)

  @@unique([perfilAcessoId, modulo])
  @@map("permissoes_de_modulo")
}

// ---------------------------------------------------------------------------
// TipoAtivo (Story 2.1) — categorias usadas para classificar ativos
// (Epic 2/3 dependem deste modelo existir primeiro). Sem exclusão física:
// "arquivar" é só mudar `status` para Arquivado pelo próprio formulário de
// edição. O modelo `Ativo` (Story 2.2) é quem vai referenciar TipoAtivo e
// trocar a contagem fixa "0" da listagem por uma contagem real.
// ---------------------------------------------------------------------------

model TipoAtivo {
  id        String          @id @default(cuid())
  contaId   String
  conta     Conta           @relation(fields: [contaId], references: [id], onDelete: Cascade)
  nome      String
  descricao String?
  status    StatusTipoAtivo @default(Ativo)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ativos Ativo[]
  planos PlanoRevisional[]

  @@unique([contaId, nome])
  @@map("tipos_de_ativo")
}

// ---------------------------------------------------------------------------
// Ativo (Story 2.2) — núcleo do produto: cada ativo cadastrado pertence a um
// TipoAtivo e a uma Conta. Sem exclusão física (AD-10): "excluir" é só mudar
// `status` para Inativo, pela mesma função de repositório usada pela edição
// comum (atualizarAtivo). `codigo` é gerado na criação ("AT-" + sequencial
// de 4 dígitos por conta, dentro de uma transação Serializable) e nunca
// reaproveita o `id` (cuid) como identificador visível.
// ---------------------------------------------------------------------------

model Ativo {
  id      String @id @default(cuid())
  contaId String
  conta   Conta  @relation(fields: [contaId], references: [id], onDelete: Cascade)

  nome        String
  tipoAtivoId String
  tipoAtivo   TipoAtivo   @relation(fields: [tipoAtivoId], references: [id])
  localizacao String
  /// Opcional (Boundaries) — exibido no sub-text da coluna "Ativo" da
  /// listagem quando preenchido.
  numeroSerie String?
  /// Formato "AT-0001" — sequencial por conta, sem ano embutido (diferente
  /// do código de Emissão). Gerado uma única vez na criação.
  codigo      String
  status      StatusAtivo @default(Ativo)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planos   PlanoRevisional[]
  emissoes Emissao[]

  @@unique([contaId, codigo])
  @@index([tipoAtivoId])
  @@map("ativos")
}

// ---------------------------------------------------------------------------
// ItemRevisional (Story 3.1) — verificações/tarefas com controle de medição
// que compõem os planos revisionais (Epic 3/Story 3.2 depende deste modelo
// existir primeiro). Os 3 controles (diasPadrao/kmPadrao/horasPadrao) são
// colunas numéricas opcionais: não-nulo significa "este controle está
// selecionado" (sem flag booleana separada) — ao menos um dos três precisa
// ser não-nulo e positivo, validado na Server Action (o banco não impõe "ao
// menos 1 de 3" sozinho). Sem exclusão física (AD-10): "excluir" é só mudar
// `status` para Arquivado, pela mesma função de repositório usada pela
// edição comum (atualizarItemRevisional).
// ---------------------------------------------------------------------------

model ItemRevisional {
  id      String @id @default(cuid())
  contaId String
  conta   Conta  @relation(fields: [contaId], references: [id], onDelete: Cascade)

  nome        String
  descricao   String?
  /// "A cada N dias" — não-nulo significa que este controle está selecionado.
  diasPadrao  Int?
  /// "A cada N km" — não-nulo significa que este controle está selecionado.
  kmPadrao    Int?
  /// "A cada N horas" — não-nulo significa que este controle está
  /// selecionado.
  horasPadrao Int?
  status      StatusItemRevisional @default(Ativo)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planoItens             PlanoItemRevisional[]
  itensExecutadosEmissao ItemExecutadoEmissao[]

  @@unique([contaId, nome])
  @@map("itens_revisionais")
}

// ---------------------------------------------------------------------------
// PlanoRevisional / PlanoItemRevisional (Story 3.2) — regra de periodicidade
// de revisão vinculada a UM Ativo OU UM Tipo de ativo (XOR validado na Server
// Action, o banco só garante a nulidade individual de cada FK), com os itens
// revisionais selecionados que compõem o plano. Sem exclusão física
// (AD-10): "excluir" é só mudar `status` para Arquivado, pela mesma função
// de repositório usada pela edição comum (atualizarPlano). Criação/edição de
// plano+itens é sempre uma única prisma.$transaction (AD-9), com lock
// otimista via `updatedAt` esperado na edição.
//
// "No prazo"/"Vence em breve" e a "próxima revisão" NUNCA são colunas
// persistidas aqui — sempre computadas on-read por
// resolverAtivosDoPlano(contaId, planoId?) em
// src/server/repositories/plano.ts (AD-8), a única função que expande um
// plano-por-tipo para os ativos daquele tipo.
// ---------------------------------------------------------------------------

model PlanoRevisional {
  id      String @id @default(cuid())
  contaId String
  conta   Conta  @relation(fields: [contaId], references: [id], onDelete: Cascade)

  nome String

  /// Vínculo XOR com tipoAtivoId: exatamente um dos dois é não-nulo, nunca
  /// os dois, nunca nenhum — validado na Server Action (Boundaries).
  ativoId String?
  ativo   Ativo?  @relation(fields: [ativoId], references: [id])

  /// Vínculo XOR com ativoId — plano-por-tipo cobre todos os Ativo daquele
  /// tipoAtivoId, expandido em tempo de leitura por resolverAtivosDoPlano
  /// (AD-8), nunca persistido como uma linha por ativo.
  tipoAtivoId String?
  tipoAtivo   TipoAtivo? @relation(fields: [tipoAtivoId], references: [id])

  responsavelId String
  responsavel   Usuario @relation(fields: [responsavelId], references: [id])

  status StatusPlanoRevisional @default(Ativo)

  itens    PlanoItemRevisional[]
  emissoes Emissao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contaId, nome])
  @@index([ativoId])
  @@index([tipoAtivoId])
  @@index([responsavelId])
  @@map("planos_revisionais")
}

// Linha de junção plano<->item revisional selecionado, com valores de
// sobrescrita opcionais por controle. Uma linha só pode sobrescrever
// (diasOverride/kmOverride/horasOverride) um controle que o próprio
// ItemRevisional já tem selecionado (não-nulo) — validado na Server Action
// contra o item real, nunca imposto pelo banco. onDelete: Cascade é só o que
// permite as linhas de item sumirem se o plano pai for removido — o plano
// pai em si nunca é DELETE físico (AD-10), então isso nunca dispara na
// prática.
model PlanoItemRevisional {
  id      String          @id @default(cuid())
  planoId String
  plano   PlanoRevisional @relation(fields: [planoId], references: [id], onDelete: Cascade)

  itemRevisionalId String
  itemRevisional   ItemRevisional @relation(fields: [itemRevisionalId], references: [id])

  /// Sobrescreve ItemRevisional.diasPadrao só para este plano, se não-nulo.
  diasOverride  Int?
  /// Sobrescreve ItemRevisional.kmPadrao só para este plano, se não-nulo.
  kmOverride    Int?
  /// Sobrescreve ItemRevisional.horasPadrao só para este plano, se não-nulo.
  horasOverride Int?

  @@unique([planoId, itemRevisionalId])
  @@map("plano_itens_revisionais")
}

// ---------------------------------------------------------------------------
// Emissao / ItemExecutadoEmissao (Story 4.1) — primeiro registro de que uma
// manutenção foi de fato executada, vinculado a um Ativo + PlanoRevisional +
// responsável + data. `codigo` ("EM-{ano}-{seq}") é gerado na criação por
// retry-on-P2002 contra `@@unique([contaId, ano, seq])` (nunca `select max`/
// transação Serializable — técnica deliberadamente diferente da de
// Ativo.codigo, Boundaries da story). `ano` é o ano de `dataEmissao` (campo
// de negócio), não a data de criação no servidor (Design Notes). Emissão +
// itens executados são sempre gravados numa única prisma.$transaction
// (AD-9), tanto na criação quanto na edição, com `updatedAt` como lock
// otimista na edição (mesmo padrão de atualizarPlano).
//
// Nasce sempre com status Rascunho — o avanço de status (Rascunho->Em
// análise->Emitido/Reprovado, incluindo o preenchimento de
// `motivoReprovacao`) é a Story 4.2, que ainda não existe (Boundaries: nesta
// story não há lógica de avanço nenhuma).
//
// Sem exclusão física NEM soft-delete nesta story (Never/Design Notes): AD-10
// não vincula Emissao (CAP-5) à sua regra de arquivamento, StatusEmissao não
// tem um valor de arquivamento, e nenhum AC pede isso — gap deferido em
// _bmad-output/implementation-artifacts/deferred-work.md.
// ---------------------------------------------------------------------------

model Emissao {
  id      String @id @default(cuid())
  contaId String
  conta   Conta  @relation(fields: [contaId], references: [id], onDelete: Cascade)

  ativoId String
  ativo   Ativo  @relation(fields: [ativoId], references: [id])

  planoId String
  plano   PlanoRevisional @relation(fields: [planoId], references: [id])

  responsavelId String
  responsavel   Usuario @relation(fields: [responsavelId], references: [id])

  /// Campo de negócio — data em que a manutenção foi/será executada. É esta
  /// data (não a de criação no servidor) que decide o `ano` do código
  /// (Design Notes: mais coerente com numeração de documento, evita códigos
  /// fora de ordem em emissões retroativas perto de virada de ano).
  dataEmissao DateTime

  /// Formato "EM-{ano}-{seq}" — gerado uma única vez na criação, nunca
  /// recalculado na edição.
  codigo String
  ano    Int
  seq    Int

  status           StatusEmissao @default(Rascunho)
  /// Preenchido só a partir da Story 4.2 (fluxo de reprovação) — nesta story
  /// fica sempre null.
  motivoReprovacao String?

  itens ItemExecutadoEmissao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contaId, ano, seq])
  @@index([ativoId])
  @@index([planoId])
  @@index([responsavelId])
  @@map("emissoes")
}

// Linha de item executado, espelhando os itens do PlanoRevisional vigente no
// momento da criação da Emissao (Intent) — uma linha por item do plano,
// nunca um subconjunto escolhido pelo usuário (a aba Itens do modal é um
// checklist fixo, Code Map). `valorEsperadoDias/Km/Horas` é o snapshot do
// valor esperado no momento em que o item entra na emissão
// (PlanoItemRevisional.override ?? ItemRevisional.padrao) — uma edição
// posterior ao Plano/Item revisional de origem NUNCA altera esse snapshot
// (Boundaries). `medicaoDias/Km/Horas` é o valor medido de fato, preenchido
// junto com `executado`/`observacao` conforme a manutenção é registrada.
//
// onDelete: Cascade é o que permite as linhas somerem se a Emissao pai for
// removida — a Emissao pai em si nunca é DELETE físico nesta story (Never),
// então isso nunca dispara na prática hoje.
model ItemExecutadoEmissao {
  id        String  @id @default(cuid())
  emissaoId String
  emissao   Emissao @relation(fields: [emissaoId], references: [id], onDelete: Cascade)

  itemRevisionalId String
  itemRevisional   ItemRevisional @relation(fields: [itemRevisionalId], references: [id])

  executado Boolean @default(false)

  /// Snapshot imutável do valor esperado no momento em que o item entrou na
  /// emissão (Boundaries) — nunca recalculado a partir do Plano/Item atual.
  valorEsperadoDias  Int?
  valorEsperadoKm    Int?
  valorEsperadoHoras Int?

  /// Valor medido de fato ao registrar a execução — comparável ao snapshot
  /// acima, mas uma coluna totalmente separada.
  medicaoDias  Int?
  medicaoKm    Int?
  medicaoHoras Int?

  observacao String?

  @@unique([emissaoId, itemRevisionalId])
  @@map("itens_executados_emissao")
}

// ---------------------------------------------------------------------------
// Local (Story 5.1) — plantas/pátios/áreas onde os ativos estão instalados,
// com a área delimitada por um polígono ilustrativo (AD-14): `areaPoligono`
// é um array de pontos `[x,y]` em coordenadas do viewBox="0 0 600 300" do
// editor client-side (src/components/locais/mapa-editor.tsx), gravado como
// Json — NUNCA lat/long, nunca integração com serviço de mapas real. Campo
// opcional: um local pode ser salvo sem polígono definido (Boundaries).
// Sem exclusão física (AD-10): "excluir" é só mudar `status` para Inativo,
// pela mesma função de repositório usada pela edição comum (atualizarLocal).
// ---------------------------------------------------------------------------

model Local {
  id      String @id @default(cuid())
  contaId String
  conta   Conta  @relation(fields: [contaId], references: [id], onDelete: Cascade)

  nome         String
  endereco     String
  /// Array de pontos `{x,y}` do viewBox do editor, ou `null` quando nenhum
  /// vértice foi marcado ainda (Boundaries — nunca obrigatório).
  areaPoligono Json?
  status       StatusLocal @default(Ativo)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contaId, nome])
  @@map("locais")
}

// ---------------------------------------------------------------------------
// Empresa (Story 5.2) — terceiros/prestadores relacionados à operação
// (razão social, nome fantasia, CNPJ e/ou CPF quando autônomo, observação
// livre). Sem `status` e sem exclusão física ou lógica: o mockup só mostra
// a ação "Editar" por linha (Boundaries/AD-17 — diferente de
// Local/TipoAtivo/Ativo/ItemRevisional/PlanoRevisional, que têm um estado de
// arquivamento). `cnpj`/`cpf`/`observacao` são opcionais e sem validação de
// dígito verificador — texto livre (Boundaries da story).
// ---------------------------------------------------------------------------

model Empresa {
  id      String @id @default(cuid())
  contaId String
  conta   Conta  @relation(fields: [contaId], references: [id], onDelete: Cascade)

  razaoSocial  String
  nomeFantasia String
  /// Opcional — empresas com CNPJ deixam `cpf` vazio.
  cnpj         String?
  /// Opcional — prestadores autônomos preenchem `cpf` em vez de `cnpj`.
  cpf          String?
  observacao   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contaId, razaoSocial])
  @@map("empresas")
}

// ---------------------------------------------------------------------------
// Cargo / Funcao (Story 5.3) — dois cadastros independentes e estruturalmente
// idênticos (um único campo `descricao` + `status`), pré-requisito da Story
// 5.4 (Pessoa), que referencia os dois por FK separadas. Deliberadamente sem
// nenhuma abstração/tabela compartilhada entre os dois (Boundaries/Never da
// story) — mesma convenção do projeto de não abstrair prematuramente entre
// entidades parecidas (Tipos vs. Locais vs. Itens revisionais). Sem exclusão
// física (AD-10): "excluir" é só mudar `status` para Inativo, pela mesma
// função de repositório usada pela edição comum (atualizarCargo/
// atualizarFuncao) — mesmo padrão de Local.
// ---------------------------------------------------------------------------

model Cargo {
  id      String @id @default(cuid())
  contaId String
  conta   Conta  @relation(fields: [contaId], references: [id], onDelete: Cascade)

  descricao String
  status    StatusCargo @default(Ativo)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pessoas Pessoa[]

  @@unique([contaId, descricao])
  @@map("cargos")
}

model Funcao {
  id      String @id @default(cuid())
  contaId String
  conta   Conta  @relation(fields: [contaId], references: [id], onDelete: Cascade)

  descricao String
  status    StatusFuncao @default(Ativo)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pessoas Pessoa[]

  @@unique([contaId, descricao])
  @@map("funcoes")
}

// ---------------------------------------------------------------------------
// Pessoa (Story 5.4) — pessoas que executam serviços/checklists, com Cargo e
// Função vinculados por FK obrigatória (nunca texto livre) — último cadastro
// complementar do Epic 5 e pré-requisito da Story 5.5 (registrar quem
// executou cada serviço numa emissão). Sem `@@unique` de nome (Code Map: o
// mockup não trata nome como identificador único de pessoa, diferente das
// demais entidades desta epic). `cpf` é texto livre, sem validação de dígito
// verificador (mesmo padrão de Empresa). Sem exclusão física nem campo
// `status` (AD-17/AD-18 — mesmo padrão de Empresa: mockup só mostra
// "Editar"). Um Cargo/Função depois inativado (StatusCargo/StatusFuncao)
// continua referenciável por uma Pessoa já vinculada — a FK não quebra
// (Boundaries/I-O Matrix da story).
// ---------------------------------------------------------------------------

model Pessoa {
  id      String @id @default(cuid())
  contaId String
  conta   Conta  @relation(fields: [contaId], references: [id], onDelete: Cascade)

  nome String
  cpf  String

  cargoId String
  cargo   Cargo @relation(fields: [cargoId], references: [id])

  funcaoId String
  funcao   Funcao @relation(fields: [funcaoId], references: [id])

  observacao String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Diferente das demais entidades do Epic 5, Pessoa não tem
  /// @@unique([contaId, ...]) (nome/CPF não são identificadores únicos aqui),
  /// então nada indexaria `contaId` de graça — e toda leitura filtra por ele
  /// (AD-1). Índice explícito para não varrer a tabela inteira por conta.
  @@index([contaId])
  @@index([cargoId])
  @@index([funcaoId])
  @@map("pessoas")
}
