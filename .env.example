# Copie este arquivo para .env.local e preencha os valores reais.
# .env.local nunca é commitado (ver .gitignore).

# Postgres (Neon) — connection string do branch de banco do ambiente.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# OPCIONAL. Banco DESCARTÁVEL usado só por `npm run prisma:deriva` (compara as
# migrations escritas à mão com o schema.prisma). O Prisma RESETA este banco a
# cada execução — aponte para um banco vazio e exclusivo, nunca para
# DATABASE_URL.
#
# Deixando VAZIO, a checagem sobe um PostgreSQL efêmero local por conta própria
# (o mesmo que os testes usam) e o derruba ao fim. Só preencha se preferir um
# banco remoto — um branch descartável do Neon, por exemplo.
SHADOW_DATABASE_URL=""

# Segredo do Better Auth (assinatura/criptografia de sessão). Gere um valor
# forte, por exemplo: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# URL base da aplicação — usada para montar os links de reset de senha.
BETTER_AUTH_URL="http://localhost:3000"

# Resend — envio de e-mail transacional (convite de usuário, reset de
# senha). Em desenvolvimento o reset de senha loga o link no
# console/terminal em vez de enviar e-mail; a integração real do Resend com
# esta chave fica para uma história/tarefa futura (Story 1.1, Intent).
RESEND_API_KEY=""

# Sentry — rastreamento de erros (AD-7). Não usado ainda nesta story.
SENTRY_DSN=""

# Bootstrap do seed inicial (prisma/seed.ts).
# SEED_CONTA_NOME="Raiz"
# SEED_CONTA_CNPJ="00.000.000/0001-00"
# SEED_ADMIN_NOME="Administrador Raiz"
# SEED_ADMIN_EMAIL="admin@raiz.local"
# SEED_ADMIN_SENHA obrigatória — sem valor padrão (o seed lança erro e para
# se ela não estiver definida). Escolha uma senha forte.
SEED_ADMIN_SENHA=""
